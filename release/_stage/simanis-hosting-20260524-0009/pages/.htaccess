Options -Indexes
RewriteEngine On

# Route page requests through the local router before PHP file access is denied.
RewriteRule ^guru/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=guru&page=$1 [L,QSA]
RewriteRule ^siswa/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=siswa&page=$1 [L,QSA]
RewriteRule ^admin/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=admin&page=$1 [L,QSA]
RewriteRule ^([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=public&page=$1 [L,QSA]

# Deny direct access to PHP files in pages/ directory
# EXCEPT router.php which handles all routing
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# But allow router.php to be accessed (it's the routing handler)
<FilesMatch "^router\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Note: Actual routing is handled by parent .htaccess rewrite rules
# which rewrite pages/guru/*, pages/siswa/*, pages/admin/* to router.php
