/**
 * config.local.php.example
 * Copy to: config.local.php (JANGAN upload ke hosting!)
 * File ini mengoverride array $cfg di koneksi.php untuk lingkungan lokal.
 */

if (!isset($cfg) || !is_array($cfg)) {
	$cfg = [];
}

$cfg = array_merge($cfg, [
	'host' => 'localhost',   // atau 127.0.0.1
	'user' => 'root',        // default XAMPP
	'password' => '',        // default kosong
	'db' => 'jurnal',        // nama database lokal Anda
	'port' => 3306,          // ganti jika memakai port berbeda
]);

// Opsional: konektor e-Raport
// Isi jika ingin menguji sinkron API dari aplikasi ini.
$eraport_base_url = 'http://103.131.217.1:8239/';
$eraport_token = 'GANTI_DENGAN_TOKEN_ERAPORT';

// Opsional: kredensial login sesi e-Raport (dibutuhkan fitur Sync e-Raport Ekskul)
$eraport_admin_username = 'administrator';
$eraport_admin_password = 'GANTI_PASSWORD_ERAPORT';
$eraport_sekolah_id = '';   // boleh dikosongkan, akan dicoba auto-detect dari halaman login
$eraport_semester = '';     // boleh dikosongkan, akan dicoba auto-detect dari halaman login

// Opsional: Login dengan Gmail/Google.
// Buat OAuth Client di Google Cloud Console, lalu set redirect URI sesuai alamat aplikasi.
