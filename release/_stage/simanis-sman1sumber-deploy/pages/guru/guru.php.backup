                                            <
                                            div class = "modal fade"
                                            id = "taskDetailModal"
                                            tabindex = "-1"
                                            aria - hidden = "true" >
                                            <
                                            div class = "modal-dialog modal-lg" >
                                            <
                                            div class = "modal-content" >
                                            <
                                            div class = "modal-header" >
                                            <
                                            h5 class = "modal-title" > Detail Tugas < /h5> <
