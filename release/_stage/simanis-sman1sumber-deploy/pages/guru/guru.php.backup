                                <?php if (!empty($sd['catatan_pelanggaran'])) { ?>
                                  <div class="pelanggaran-scroll" style="max-height:80px; overflow-y:auto; font-size:0.8rem; line-height:1.2;">
                                    <?= htmlspecialchars($sd['catatan_pelanggaran']) ?>
                                  </div>
