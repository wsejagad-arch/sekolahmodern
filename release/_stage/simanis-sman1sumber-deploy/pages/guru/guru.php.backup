    function inputJurnal(mapelId = null) {
      if (mapelId) {
        // Redirect to specific journal input
        window.location.href = 'guru_jurnal.php?id=' + mapelId;
      } else {
        // Show modal to select schedule
        const modal = new bootstrap.Modal(document.getElementById('scheduleModal'));
        modal.show();
      }
    }

    // Update time every minute
    function updateTime() {
      const now = new Date();
      const timeString = now.toLocaleTimeString('id-ID', {
        hour: '2-digit',
        minute: '2-digit'
      });
      // You can add a clock display if needed
    }

    setInterval(updateTime, 60000);
    updateTime();
  </script>
