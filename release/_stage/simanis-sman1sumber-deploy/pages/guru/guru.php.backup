                                <script>
                                  $(document).ready(function() {
                                    // --- Notification Bell Toggle ---
                                    const bellWrap = document.getElementById('notifBellWrap');
                                    const notifDD = document.getElementById('notifDropdown');

                                    if (bellWrap && notifDD) {
                                      bellWrap.addEventListener('click', function(e) {
                                        e.stopPropagation();
                                        notifDD.classList.toggle('show');
                                      });

                                      document.addEventListener('click', function(e) {
                                        if (!bellWrap.contains(e.target)) {
                                          notifDD.classList.remove('show');
                                        }
                                      });

                                      // Handle scroll-to anchors inside notif
                                      notifDD.querySelectorAll('.notif-item').forEach(function(item) {
                                        item.addEventListener('click', function(e) {
                                          const action = this.getAttribute('data-notif-action');

                                          if (action && action.startsWith('#') && action !== '#') {
                                            e.preventDefault();
                                            notifDD.classList.remove('show');
                                            const target = document.querySelector(action);

                                            if (target) target.scrollIntoView({
                                              behavior: 'smooth',
                                              block: 'start'
                                            });
                                          }
                                        });
                                      });
                                    }

