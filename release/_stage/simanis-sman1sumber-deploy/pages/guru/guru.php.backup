// Fallback ke kolom legacy tbl_kelas.nip_wali bila tabel tbl_wali_kelas kosong
$resLegacy = mysqli_query($conn, "SELECT id_kelas, kelas FROM tbl_kelas WHERE nip_wali='" . $nipEsc . "' LIMIT 1");
if ($resLegacy && mysqli_num_rows($resLegacy) > 0) {
$rowL = mysqli_fetch_assoc($resLegacy);
$waliKelasId = $rowL['id_kelas'];
$waliKelasNama = $rowL['kelas'];
}
}

// Set variabel untuk default selection di dropdown pelanggaran
$kelasWali = $waliKelasNama;

if ($waliKelasNama) {
// Ambil daftar siswa aktif pada kelas wali
$kelasEsc = mysqli_real_escape_string($conn, $waliKelasNama);
$qS = mysqli_query($conn, "SELECT no_induk, nama_siswa FROM tbl_siswa WHERE kelas='" . $kelasEsc . "' AND (status IS NULL OR status='' OR UPPER(status)='AKTIF') ORDER BY nama_siswa");
$siswaList = [];
while ($qS && ($r = mysqli_fetch_assoc($qS))) {
$siswaList[$r['no_induk']] = [
'no_induk' => $r['no_induk'],
'nama' => $r['nama_siswa'],
];
}

if (!empty($siswaList)) {
$bulanNow = date('Y-m');

// Agregasi absensi bulan berjalan untuk semua siswa kelas wali (1 query), guard jika tabel belum ada
$absAgg = [];
$tblAb = mysqli_query($conn, "SHOW TABLES LIKE 'tbl_absen'");
if ($tblAb && mysqli_num_rows($tblAb) > 0) {
$qAbsen = mysqli_query($conn, "SELECT no_induk,
SUM(status='Alpha') AS alpha,
SUM(status='Ijin') AS ijin,
SUM(status='Sakit') AS sakit,
SUM(status='Dispen') AS dispen
FROM tbl_absen
WHERE kelas='" . $kelasEsc . "' AND DATE_FORMAT(tanggal, '%Y-%m')='" . $bulanNow . "'
GROUP BY no_induk");
while ($qAbsen && ($ra = mysqli_fetch_assoc($qAbsen))) {
$absAgg[$ra['no_induk']] = [
'alpha' => (int)($ra['alpha'] ?? 0),
'ijin' => (int)($ra['ijin'] ?? 0),
'sakit' => (int)($ra['sakit'] ?? 0),
'dispen' => (int)($ra['dispen'] ?? 0),
];
}
}

// Rata-rata nilai tugas (semua waktu untuk kelas tsb) – dipakai sebagai indikator tugas (guard jika tabel belum ada)
$nilaiAgg = [];
$tblNil = mysqli_query($conn, "SHOW TABLES LIKE 'tbl_nilai'");
if ($tblNil && mysqli_num_rows($tblNil) > 0) {
$qNil = mysqli_query($conn, "SELECT no_induk_siswa, AVG(NULLIF(nilai_tugas,0)) AS avg_tugas
FROM tbl_nilai
WHERE kelas='" . $kelasEsc . "'
GROUP BY no_induk_siswa");
while ($qNil && ($rn = mysqli_fetch_assoc($qNil))) {
$nilaiAgg[$rn['no_induk_siswa']] = (float)$rn['avg_tugas'];
}
}

// Data pelanggaran siswa (bulan berjalan)
$pelanggaranAgg = [];
$tblPelanggaran = mysqli_query($conn, "SHOW TABLES LIKE 'tbl_pelanggaran'");
if ($tblPelanggaran && mysqli_num_rows($tblPelanggaran) > 0) {
$qPelanggaran = mysqli_query($conn, "SELECT no_induk,
GROUP_CONCAT(CONCAT(DATE_FORMAT(tanggal_pelanggaran, '%d/%m'), ': ', jenis_pelanggaran, ' (', kategori_pelanggaran, ')') ORDER BY tanggal_pelanggaran DESC SEPARATOR '; ') AS catatan_pelanggaran,
SUM(kategori_pelanggaran='Berat') AS pelanggaran_berat,
SUM(kategori_pelanggaran='Sedang') AS pelanggaran_sedang,
SUM(kategori_pelanggaran='Ringan') AS pelanggaran_ringan
FROM tbl_pelanggaran
WHERE kelas='" . $kelasEsc . "' AND DATE_FORMAT(tanggal_pelanggaran, '%Y-%m')='" . $bulanNow . "' AND status_pelanggaran='Aktif'
GROUP BY no_induk");
while ($qPelanggaran && ($rp = mysqli_fetch_assoc($qPelanggaran))) {
$pelanggaranAgg[$rp['no_induk']] = [
'catatan' => $rp['catatan_pelanggaran'] ?? '',
'berat' => (int)($rp['pelanggaran_berat'] ?? 0),
'sedang' => (int)($rp['pelanggaran_sedang'] ?? 0),
'ringan' => (int)($rp['pelanggaran_ringan'] ?? 0),
];
}
}

// Gabung dan skor
foreach ($siswaList as $nis => $info) {
$a = $absAgg[$nis] ?? ['alpha' => 0, 'ijin' => 0, 'sakit' => 0, 'dispen' => 0];
$avgTugas = isset($nilaiAgg[$nis]) ? round($nilaiAgg[$nis], 1) : null;
$pelanggaran = $pelanggaranAgg[$nis] ?? ['catatan' => '', 'berat' => 0, 'sedang' => 0, 'ringan' => 0];

// Skor masalah: Alpha bobot 3, ijin/sakit/dispen bobot 0.5, plus penalti jika nilai tugas rendah (<75), plus pelanggaran
  $score=($a['alpha'] * 3) + (($a['ijin'] + $a['sakit'] + $a['dispen']) * 0.5);
  if ($avgTugas !==null && $avgTugas < 75) {
  $score +=min(3, (75 - $avgTugas) / 10); // maksimum +3
  }
  // Tambah skor pelanggaran: Berat +5, Sedang +2, Ringan +1
  $score +=($pelanggaran['berat'] * 5) + ($pelanggaran['sedang'] * 2) + ($pelanggaran['ringan'] * 1);

  if ($a['alpha']>= 3) {
  $waliAlpha3List[] = ['nis' => $nis, 'nama' => $info['nama'], 'alpha' => $a['alpha']];
  }

  $waliSiswaData[] = [
  'no_induk' => $nis,
  'nama' => $info['nama'],
  'alpha' => $a['alpha'],
  'ijin' => $a['ijin'],
  'sakit' => $a['sakit'],
  'dispen' => $a['dispen'],
  'avg_tugas' => $avgTugas,
  'score' => $score,
  'catatan_pelanggaran' => $pelanggaran['catatan'],
  'pelanggaran_berat' => $pelanggaran['berat'],
  'pelanggaran_sedang' => $pelanggaran['sedang'],
  'pelanggaran_ringan' => $pelanggaran['ringan'],
  ];
  }

  // Urutkan berdasarkan skor masalah (desc) lalu alpha desc
  usort($waliSiswaData, function ($x, $y) {
  if ($x['score'] == $y['score']) return $y['alpha'] <=> $x['alpha'];
    return ($y['score'] <=> $x['score']);
      });
      }
      }

      // --- Data Izin Siswa untuk Validasi ---
      $izinUntukValidasi = [];
      $jumlahIzinValidasi = 0;

      // Cek dulu apakah tabel izin sudah ada sebelum query
      $tableCheck = mysqli_query($conn, "SHOW TABLES LIKE 'tbl_izin_siswa'");
      if ($tableCheck && mysqli_num_rows($tableCheck) > 0) {
      $nipGuruEsc = mysqli_real_escape_string($conn, $nipguru);
      $today = date('Y-m-d');

      // 1. Ambil izin yang perlu divalidasi sebagai GURU MAPEL
      $izinMapelQuery = "SELECT iz.*, s.nama_siswa FROM tbl_izin_siswa iz
      JOIN tbl_siswa s ON iz.no_induk_siswa = s.no_induk
      JOIN tbl_mapel_ampu ma ON iz.kelas_siswa = ma.kelas
      WHERE ma.no_induk = '$nipGuruEsc'
      AND iz.tanggal_izin = '$today'
      AND iz.status_izin = 'Menunggu Validasi'
      AND iz.validasi_guru_mapel = 'Menunggu'";
      $resIzinMapel = mysqli_query($conn, $izinMapelQuery);
      if ($resIzinMapel) {
      while ($row = mysqli_fetch_assoc($resIzinMapel)) {
      $izinUntukValidasi[$row['id_izin']] = $row;
      }
      }

      // 2. Ambil izin yang perlu divalidasi sebagai WALI KELAS
      if ($waliKelasNama) {
      $izinWaliQuery = "SELECT iz.*, s.nama_siswa FROM tbl_izin_siswa iz
      JOIN tbl_siswa s ON iz.no_induk_siswa = s.no_induk
      WHERE iz.kelas_siswa = '" . mysqli_real_escape_string($conn, $waliKelasNama) . "'
      AND iz.status_izin IN ('Menunggu Validasi', 'Menunggu Wali Kelas', 'Disetujui Sebagian')
      AND iz.validasi_wali_kelas = 'Menunggu'";
      $resIzinWali = mysqli_query($conn, $izinWaliQuery);
      if ($resIzinWali) {
      while ($row = mysqli_fetch_assoc($resIzinWali)) {
      $izinUntukValidasi[$row['id_izin']] = $row;
      }
      }
      }

      // 3. Ambil izin yang perlu divalidasi sebagai GURU BK
      $isGuruBK = !empty($dataguru['is_guru_bk']);
      if ($isGuruBK) {
      $izinBkQuery = "SELECT iz.*, s.nama_siswa FROM tbl_izin_siswa iz
      JOIN tbl_siswa s ON iz.no_induk_siswa = s.no_induk
      WHERE iz.status_izin IN ('Menunggu Validasi', 'Menunggu Guru BK', 'Disetujui Sebagian')
      AND iz.validasi_guru_bk = 'Menunggu'
      AND iz.validasi_wali_kelas = 'Disetujui'";
      $resIzinBk = mysqli_query($conn, $izinBkQuery);
      if ($resIzinBk) {
      while ($row = mysqli_fetch_assoc($resIzinBk)) {
      $izinUntukValidasi[$row['id_izin']] = $row;
      }
      }
      }
      $jumlahIzinValidasi = count($izinUntukValidasi);
      }

      // Notifikasi wali kelas: izin dari kelasnya yang ditolak oleh Guru BK
      $izinDitolakBK = [];
      if (!empty($waliKelasNama)) {
      $__tblIzinChk = mysqli_query($conn, "SHOW TABLES LIKE 'tbl_izin_siswa'");
      if ($__tblIzinChk && mysqli_num_rows($__tblIzinChk) > 0 && $waliKelasNama) {
      $wkEsc = mysqli_real_escape_string($conn, $waliKelasNama);
      $resIzinBKTolak = mysqli_query($conn, "SELECT iz.*, s.nama_siswa
      FROM tbl_izin_siswa iz
      JOIN tbl_siswa s ON iz.no_induk_siswa = s.no_induk
      WHERE iz.kelas_siswa = '$wkEsc'
      AND iz.validasi_guru_bk = 'Ditolak'
      AND iz.validasi_wali_kelas = 'Disetujui'
      AND DATE(COALESCE(iz.waktu_validasi_guru_bk, iz.waktu_pengajuan)) >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)
      ORDER BY iz.waktu_validasi_guru_bk DESC");
      if ($resIzinBKTolak) {
      while ($row = mysqli_fetch_assoc($resIzinBKTolak)) {
      $izinDitolakBK[] = $row;
      }
      }
      }
      }

      // --- BUILD NOTIFICATIONS ---
      $notifications = [];

      // 1. Jurnal belum terisi hari ini
      $jurnalBelumTerisi = $totalJadwal - $jurnalTerisi;
      if ($jurnalBelumTerisi > 0) {
      // Cari mapel mana yang belum diisi
      $mapelBelumIsi = [];
      if ($dateCol && !empty($mapelIds)) {
      $idList = implode(',', $mapelIds);
      $tglEsc = mysqli_real_escape_string($conn, $tglskr);
      $qTerisi = mysqli_query($conn, "SELECT DISTINCT id_mapel FROM tbl_materi WHERE `$dateCol`='$tglEsc' AND id_mapel IN ($idList)");
      $terisiIds = [];
      if ($qTerisi) while ($rt = mysqli_fetch_assoc($qTerisi)) $terisiIds[] = (int)$rt['id_mapel'];
      foreach ($jadwalHariIni as $jh) {
      if (!in_array((int)$jh['id_mapel'], $terisiIds)) {
      $mapelBelumIsi[] = $jh['nama_mapel'] . ' (' . $jh['kelas'] . ')';
      }
      }
      }
      $detailJurnal = !empty($mapelBelumIsi) ? implode(', ', $mapelBelumIsi) : $jurnalBelumTerisi . ' mapel';
      $notifications[] = [
      'type' => 'warning',
      'icon' => 'bi-journal-x',
      'title' => 'Jurnal Belum Terisi',
      'message' => $detailJurnal,
      'time' => date('H:i'),
      'action' => '#scheduleSection'
      ];
      }

      // 2. Jadwal hari ini
      if ($totalJadwal > 0) {
      $jadwalBerikutnya = null;
      foreach ($jadwalHariIni as $jh) {
      $st = getTimeStatus($jh['jam_mulai'], $jh['jam_selesai']);
      if ($st === 'ongoing') {
      $notifications[] = [
      'type' => 'info',
      'icon' => 'bi-clock-fill',
      'title' => 'Sedang Berlangsung',
      'message' => $jh['nama_mapel'] . ' - ' . $jh['kelas'] . ' (' . $jh['jam_mulai'] . '-' . $jh['jam_selesai'] . ')',
      'time' => $jh['jam_mulai'],
      'action' => '#scheduleSection'
      ];
      } elseif ($st === 'upcoming' && !$jadwalBerikutnya) {
      $jadwalBerikutnya = $jh;
      }
      }
      if ($jadwalBerikutnya) {
      $notifications[] = [
      'type' => 'primary',
      'icon' => 'bi-calendar-event',
      'title' => 'Jadwal Berikutnya',
      'message' => $jadwalBerikutnya['nama_mapel'] . ' - ' . $jadwalBerikutnya['kelas'] . ' (' . $jadwalBerikutnya['jam_mulai'] . '-' . $jadwalBerikutnya['jam_selesai'] . ')',
      'time' => $jadwalBerikutnya['jam_mulai'],
      'action' => '#scheduleSection'
      ];
      }
      } else {
      $notifications[] = [
      'type' => 'success',
      'icon' => 'bi-emoji-smile',
      'title' => 'Tidak Ada Jadwal',
      'message' => 'Hari ini tidak ada jadwal mengajar.',
      'time' => date('H:i'),
      'action' => '#'
      ];
      }

      // 3. Validasi izin menunggu
      if ($jumlahIzinValidasi > 0) {
      $notifications[] = [
      'type' => 'danger',
      'icon' => 'bi-person-exclamation',
      'title' => 'Validasi Izin Siswa',
      'message' => $jumlahIzinValidasi . ' pengajuan izin menunggu validasi Anda.',
      'time' => date('H:i'),
      'action' => 'validasi-izin.php'
      ];
      }

      // 4a. Notifikasi WK: izin dari kelas ditolak oleh Guru BK
      if (!empty($izinDitolakBK)) {
      $namaListBK = array_map(function ($r) {
      return $r['nama_siswa'];
      }, array_slice($izinDitolakBK, 0, 3));
      $sisaBK = count($izinDitolakBK) > 3 ? ' +' . (count($izinDitolakBK) - 3) . ' lainnya' : '';
      $catatanBK = !empty($izinDitolakBK[0]['catatan_penolakan']) ? ': ' . mb_substr($izinDitolakBK[0]['catatan_penolakan'], 0, 60) : '';
      $notifications[] = [
      'type' => 'warning',
      'icon' => 'bi-person-x-fill',
      'title' => 'Izin Ditolak oleh Guru BK',
      'message' => implode(', ', $namaListBK) . $sisaBK . $catatanBK,
      'time' => date('H:i'),
      'action' => 'validasi-izin.php'
      ];
      }

      // 4. Siswa alpha >= 3 (peringatan wali kelas)
      if (!empty($waliAlpha3List)) {
      $namaAlpha = array_map(function ($s) {
      return $s['nama'] . ' (' . $s['alpha'] . 'x)';
      }, array_slice($waliAlpha3List, 0, 3));
      $sisaAlpha = count($waliAlpha3List) - 3;
      $msgAlpha = implode(', ', $namaAlpha) . ($sisaAlpha > 0 ? " +{$sisaAlpha} lainnya" : '');
      $notifications[] = [
      'type' => 'danger',
      'icon' => 'bi-exclamation-triangle-fill',
      'title' => 'Peringatan Alpha',
      'message' => $msgAlpha,
      'time' => date('H:i'),
      'action' => '#'
      ];
      }

      $totalNotif = count($notifications);
      ?>
