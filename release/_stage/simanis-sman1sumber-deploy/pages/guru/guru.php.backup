                                            textarea class = "form-control"
                                            id = "tindakanGuru"
                                            name = "tindakan_guru"
                                            rows = "2"
                                            placeholder = "Tindakan yang sudah/akan diambil..." > < /textarea> < /
                                            div >

                                            <
