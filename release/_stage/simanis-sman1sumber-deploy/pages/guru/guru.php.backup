      padding: 6px 0;
      }

      .notif-dropdown-body::-webkit-scrollbar {
      width: 4px;
      }

      .notif-dropdown-body::-webkit-scrollbar-thumb {
      background: #c0c0c0;
      border-radius: 4px;
      }

      .notif-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 10px 14px;
      border-bottom: 1px solid #f0f0f0;
