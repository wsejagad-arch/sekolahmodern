<?php
session_start();
if (!isset($_SESSION["no_induk"])) {
  header("location: ../../index.php?haruslogin");
  exit;
} else if ($_SESSION['hak_akses'] != 2) {
  echo "<script>window.location='404.html';</script>";
  exit;
}

include "../../koneksi.php";
include "../../functions.php";
date_default_timezone_set('Asia/Jakarta');

$nipguru = $_SESSION['no_induk'];
$tglskr = date("Y-m-d");
$hariini = ubah_nama_hari($tglskr);
$lembaga = data_lembaga();

$sqlguru = mysqli_query($conn, "SELECT * FROM tbl_guru WHERE no_induk='$nipguru'");
$dataguru = mysqli_fetch_array($sqlguru);
$namaGuru = $dataguru['nama_guru'] ?? 'Guru';

// Get today's schedule
$jadwalHariIni = [];
$query = mysqli_query($conn, "SELECT id_mapel, kelas, nama_mapel, jam_mulai, jam_selesai FROM tbl_mapel_ampu WHERE no_induk='$nipguru' AND hari='$hariini' ORDER BY jam_mulai ASC");
while ($row = mysqli_fetch_assoc($query)) {
  $jadwalHariIni[] = $row;
}

// Calculate journal completion
$totalJadwal = count($jadwalHariIni);
$jurnalTerisi = 0;
if ($totalJadwal > 0) {
  $mapelIds = array_column($jadwalHariIni, 'id_mapel');
  $idList = implode(',', array_map('intval', $mapelIds));
  $dateCol = 'tanggal'; // Assuming standard column name

  $query = mysqli_query($conn, "SELECT COUNT(DISTINCT id_mapel) as jml FROM tbl_materi WHERE $dateCol='$tglskr' AND id_mapel IN ($idList)");
  if ($query) {
    $result = mysqli_fetch_assoc($query);
    $jurnalTerisi = (int)($result['jml'] ?? 0);
  }
}
$percentJurnal = $totalJadwal > 0 ? round(($jurnalTerisi / $totalJadwal) * 100) : 0;

// Get classes taught
$kelasList = [];
$query = mysqli_query($conn, "SELECT DISTINCT kelas FROM tbl_mapel_ampu WHERE no_induk='$nipguru' ORDER BY kelas");
while ($row = mysqli_fetch_assoc($query)) {
  $kelasList[] = $row['kelas'];
}

// Get pending validations
$izinMenunggu = 0; // This would need to be implemented based on your izin table

// Helper functions
function getStatusBadge($status)
{
  $badges = [
    'upcoming' => '<span class="badge bg-warning">Akan Datang</span>',
    'ongoing' => '<span class="badge bg-success">Sedang Berlangsung</span>',
    'finished' => '<span class="badge bg-secondary">Selesai</span>'
  ];
  return $badges[$status] ?? '<span class="badge bg-light text-dark">Tidak Diketahui</span>';
}

function getTimeStatus($mulai, $selesai)
{
  $now = date('H:i');
  $current = strtotime($now);
  $start = strtotime($mulai);
  $end = strtotime($selesai);

  if ($current < $start) return 'upcoming';
  if ($current >= $start && $current <= $end) return 'ongoing';
  return 'finished';
}
