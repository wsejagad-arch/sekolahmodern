      /* Notification Bell */
      .notif-bell-wrap {
      position: relative;
      cursor: pointer;
      margin-right: 12px;
      }

      .notif-bell-wrap .bi-bell-fill {
      font-size: 1.4rem;
      color: #fff;
      transition: transform .2s;
      }

      .notif-bell-wrap:hover .bi-bell-fill {
      transform: rotate(15deg);
      }

      .notif-badge {
      position: absolute;
      top: -4px;
      right: -6px;
      background: #dc3545;
      color: #fff;
      font-size: .6rem;
      font-weight: 700;
      min-width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      border: 2px solid #6610f2;
      animation: notif-pulse 2s infinite;
      }

      @keyframes notif-pulse {

      0%,
      100% {
      transform: scale(1)
      }

      50% {
      transform: scale(1.15)
      }
      }

      .notif-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      right: -10px;
      width: 340px;
      max-height: 420px;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, .18);
      z-index: 9999;
      overflow: hidden;
      display: none;
      }

      .notif-dropdown.show {
      display: block;
      animation: notifSlide .2s ease;
      }

      @keyframes notifSlide {
      from {
      opacity: 0;
      transform: translateY(-8px)
      }

      to {
      opacity: 1;
      transform: translateY(0)
      }
      }

      .notif-dropdown-header {
      padding: 12px 16px;
      background: linear-gradient(135deg, #0d6efd, #6610f2);
      color: #fff;
      font-weight: 600;
      font-size: .9rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      }

      .notif-dropdown-body {
      max-height: 350px;
