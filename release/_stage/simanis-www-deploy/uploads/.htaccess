Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|php5|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php|phtml|php5|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
