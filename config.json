{
  "name": "Jurnal Continue Agent",
  "version": "1.0.0",
  "schema": "v1",
  "models": [
    {
      "name": "llama3.1",
      "provider": "ollama",
      "model": "llama3.1:latest",
      "roles": ["chat", "edit", "apply", "autocomplete"],
      "defaultCompletionOptions": {
        "temperature": 0.2,
        "maxTokens": 1500,
        "contextLength": 131072
      }
    }
  ],
  "context": [
    { "provider": "file" },
    { "provider": "code" }
  ],
  "rules": [
    "Always prioritize local repository context and existing PHP code."
  ]
}
