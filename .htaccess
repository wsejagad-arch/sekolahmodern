# SIMANIS - root domain (file langsung di public_html/)
DirectoryIndex index.php splash.php login.php
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule ^masuk$ login.php [L,QSA]
RewriteRule ^auth$ login_action.php [L,QSA]
RewriteRule ^keluar$ logout.php [L,QSA]
RewriteRule ^lupa-password$ forgot-password.php [L,QSA]
RewriteRule ^home/?$ home.php [L,QSA]
RewriteRule ^home/([a-zA-Z0-9_-]+)$ home.php?page=$1 [L,QSA]
RewriteRule ^detail-profil-siswa/([0-9a-zA-Z_-]+)$ detail-profil-siswa.php?no_induk=$1 [L,QSA]
RewriteRule ^detail-guru/([0-9a-zA-Z_-]+)$ detail-guru.php?id=$1 [L,QSA]
RewriteRule ^hapus-siswa/([0-9a-zA-Z_-]+)$ delete-siswa.php?no_induk=$1 [L,QSA]
RewriteRule ^admin$ home.php?page=admin [L,QSA]
RewriteRule ^guru$ home.php?page=guru [L,QSA]
RewriteRule ^siswa$ home.php?page=siswa [L,QSA]
RewriteRule ^kelas$ home.php?page=kelas [L,QSA]
RewriteRule ^mapel$ home.php?page=mapel [L,QSA]
RewriteRule ^jadwal$ home.php?page=jadwal [L,QSA]
RewriteRule ^kehadiran$ home.php?page=kehadiran [L,QSA]
RewriteRule ^jurnal$ home.php?page=jurnal [L,QSA]
RewriteRule ^pengumuman$ home.php?page=pengumuman [L,QSA]

# Fallbacks for footer links (in case of cached HTML)
RewriteRule ^data-siswa$ router.php?type=guru&page=data-siswa [L,QSA]
RewriteRule ^history-tugas$ router.php?type=guru&page=history-tugas [L,QSA]
RewriteRule ^history-pertemuan$ router.php?type=guru&page=history-pertemuan [L,QSA]
RewriteRule ^profil-guru$ router.php?type=guru&page=profil-guru [L,QSA]

RewriteRule ^pages/guru/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=guru&page=$1 [L,QSA]
RewriteRule ^pages/siswa/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=siswa&page=$1 [L,QSA]
RewriteRule ^pages/admin/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=admin&page=$1 [L,QSA]
RewriteRule ^pages/([a-zA-Z0-9_-]+)(?:\.php)?/?$ router.php?type=public&page=$1 [L,QSA]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(config\.php|config\.local\.php|config\.hosting\.php|koneksi\.php|koneksi_local\.php|koneksi_hosting\.php|bootstrap\.php|auth_helper\.php|functions\.php|composer\.json|composer\.lock|\.env|\.git|\.htpasswd)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)^(config\.php|config\.local\.php|config\.hosting\.php|koneksi\.php|koneksi_local\.php|koneksi_hosting\.php|bootstrap\.php|auth_helper\.php|functions\.php|composer\.json|composer\.lock|\.env|\.git|\.htpasswd)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ======================================================================
# OPTIMASI HIGH CONCURRENCY: KOMPRESI & CACHING
# ======================================================================

# 1. Mengaktifkan Kompresi GZIP / DEFLATE
<IfModule mod_deflate.c>
    # Kompres file HTML, teks, CSS, XML, Javascript, dan JSON
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 2. Mengaktifkan Browser Caching (Menghindari Server Load Berlebih)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Default cache: 1 bulan
    ExpiresDefault "access plus 1 month"
    
    # CSS dan JS cache 1 minggu (karena mungkin ada update)
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
    
    # Gambar cache 1 bulan
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    
    # Font cache 1 tahun (font jarang berubah)
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-opentype "access plus 1 year"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Menonaktifkan ETag agar browser hanya bergantung pada Expires dan Cache-Control
# Ini membantu meringankan beban server pada cluster/shared hosting
<IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "max-age=604800, public" "expr=%{CONTENT_TYPE} =~ m#text/css|application/javascript|image/.*|font/.*#i"
</IfModule>
